# Required to generate AI responses. Leave empty to start only the health endpoint.
ORCAROUTER_API_KEY=
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
JARVIS_MODEL=orcarouter/auto

# Optional compatibility token. When set, POST /v1/responses requires the same
# X-Jarvis-Client-Token header used by the existing Swift client.
JARVIS_CLIENT_TOKEN=
